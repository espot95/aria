---
// Illustrazione decorativa che richiama la cartomanzia:
// tre tarocchi a ventaglio (La Stella, La Luna, Il Sole) con stelle e scintille.
// Palette del brand: blu notte + oro.
---

<svg
  class="illustrazione-tarocchi"
  viewBox="0 0 420 500"
  role="img"
  aria-label="Illustrazione di tre carte dei tarocchi con luna, sole e stelle"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="cartaBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0e2647" />
      <stop offset="1" stop-color="#0a1c37" />
    </linearGradient>
    <radialGradient id="alone" cx="50%" cy="62%" r="55%">
      <stop offset="0" stop-color="#C7A14A" stop-opacity="0.35" />
      <stop offset="60%" stop-color="#C7A14A" stop-opacity="0.06" />
      <stop offset="100%" stop-color="#C7A14A" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- alone caldo -->
  <ellipse cx="210" cy="300" rx="200" ry="200" fill="url(#alone)" />

  <!-- stelle e scintille sullo sfondo -->
  <g fill="#dcbf74">
    <circle cx="55" cy="80" r="2" />
    <circle cx="360" cy="70" r="2.5" />
    <circle cx="390" cy="150" r="1.6" />
    <circle cx="35" cy="200" r="1.6" />
    <circle cx="380" cy="330" r="2" />
    <circle cx="45" cy="360" r="2.2" />
    <circle cx="330" cy="430" r="1.8" />
    <circle cx="90" cy="450" r="1.6" />
  </g>
  <g stroke="#dcbf74" stroke-width="1.4" stroke-linecap="round" opacity="0.85">
    <g transform="translate(70,120)">
      <path d="M0,-9 L0,9 M-9,0 L9,0" />
    </g>
    <g transform="translate(355,240) scale(0.8)">
      <path d="M0,-9 L0,9 M-9,0 L9,0" />
    </g>
    <g transform="translate(300,55) scale(0.7)">
      <path d="M0,-9 L0,9 M-9,0 L9,0" />
    </g>
  </g>

  <!-- =================== CARTA SINISTRA: LA STELLA =================== -->
  <g transform="rotate(-15 130 300)">
    <rect x="58" y="150" width="140" height="220" rx="14"
          fill="url(#cartaBg)" stroke="#C7A14A" stroke-width="2" />
    <rect x="68" y="160" width="120" height="200" rx="9"
          fill="none" stroke="#C7A14A" stroke-width="1" opacity="0.45" />
    <!-- stella a otto punte -->
    <g transform="translate(128,250)" stroke="#dcbf74" fill="none" stroke-width="2" stroke-linecap="round">
      <path d="M0,-40 L0,40 M-40,0 L40,0 M-28,-28 L28,28 M-28,28 L28,-28" />
    </g>
    <circle cx="128" cy="250" r="7" fill="#C7A14A" />
    <g fill="#dcbf74">
      <circle cx="98" cy="205" r="2" />
      <circle cx="160" cy="215" r="1.6" />
      <circle cx="150" cy="300" r="2" />
      <circle cx="104" cy="305" r="1.6" />
    </g>
  </g>

  <!-- =================== CARTA DESTRA: IL SOLE =================== -->
  <g transform="rotate(15 290 300)">
    <rect x="222" y="150" width="140" height="220" rx="14"
          fill="url(#cartaBg)" stroke="#C7A14A" stroke-width="2" />
    <rect x="232" y="160" width="120" height="200" rx="9"
          fill="none" stroke="#C7A14A" stroke-width="1" opacity="0.45" />
    <!-- sole con raggi -->
    <g transform="translate(292,250)">
      <g stroke="#dcbf74" stroke-width="2" stroke-linecap="round">
        <path d="M0,-42 L0,-28 M0,42 L0,28 M-42,0 L-28,0 M42,0 L28,0
                 M-30,-30 L-20,-20 M30,-30 L20,-20 M-30,30 L-20,20 M30,30 L20,20" />
      </g>
      <circle cx="0" cy="0" r="20" fill="none" stroke="#C7A14A" stroke-width="2.5" />
      <circle cx="0" cy="0" r="8" fill="#C7A14A" />
    </g>
  </g>

  <!-- =================== CARTA CENTRALE: LA LUNA =================== -->
  <g>
    <rect x="140" y="120" width="140" height="230" rx="15"
          fill="url(#cartaBg)" stroke="#C7A14A" stroke-width="2.5" />
    <rect x="150" y="130" width="120" height="210" rx="10"
          fill="none" stroke="#C7A14A" stroke-width="1.2" opacity="0.5" />
    <!-- luna crescente -->
    <path d="M226,205 a34 34 0 1 0 0,66 a26 26 0 1 1 0,-66 z"
          fill="#dcbf74" transform="translate(-8,0)" />
    <!-- volto sottile della luna -->
    <g stroke="#0a1c37" stroke-width="1.4" stroke-linecap="round" opacity="0.65">
      <path d="M200,232 q4,4 8,0" />
    </g>
    <!-- stelle attorno -->
    <g fill="#dcbf74">
      <circle cx="168" cy="175" r="2" />
      <circle cx="252" cy="180" r="1.8" />
      <circle cx="176" cy="315" r="1.8" />
      <circle cx="248" cy="310" r="2" />
    </g>
    <g stroke="#dcbf74" stroke-width="1.4" stroke-linecap="round">
      <path d="M210,300 l0,16 M202,308 l16,0" opacity="0.9" />
    </g>
  </g>
</svg>

<style>
  .illustrazione-tarocchi {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.45));
    animation: fluttua 6s ease-in-out infinite;
  }
  @keyframes fluttua {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .illustrazione-tarocchi { animation: none; }
  }
</style>
