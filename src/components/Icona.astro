---
// Icone lineari eleganti (stroke oro). Uso: <Icona nome="ascolto" />
const { nome, size = 34 } = Astro.props;
---

<span class="icona" aria-hidden="true">
  {nome === "ascolto" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 12a9 9 0 0 1 18 0" />
      <path d="M21 16a3 3 0 0 1-3 3h-.5a1.5 1.5 0 0 1-1.5-1.5V14a1.5 1.5 0 0 1 1.5-1.5H21z" />
      <path d="M3 16a3 3 0 0 0 3 3h.5A1.5 1.5 0 0 0 8 17.5V14a1.5 1.5 0 0 0-1.5-1.5H3z" />
    </svg>
  )}
  {nome === "tarocchi" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="7" y="4" width="10" height="16" rx="1.5" transform="rotate(-8 12 12)" />
      <path d="M12 9.5l1 2 1-2" />
      <path d="M12 9.5l-1 2-1-2" opacity="0.5" />
      <circle cx="12" cy="14.5" r="1.1" />
    </svg>
  )}
  {nome === "completo" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8z" />
      <circle cx="18" cy="17" r="2.4" />
      <path d="M6.5 18.5l.7 1.6 1.6.7-1.6.7-.7 1.6-.7-1.6L4.2 20.8l1.6-.7z" />
    </svg>
  )}
  {nome === "luna" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
    </svg>
  )}
</span>

<style>
  .icona {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--oro);
  }
</style>
