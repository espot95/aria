---
import Layout from "../layouts/Layout.astro";
import IntestazionePagina from "../components/IntestazionePagina.astro";
import { prenotazione, whatsappLink, contatti, consulti, tariffe } from "../data/site.js";

const metodiPagamento = ["PayPal", "Carta", "Apple Pay", "Google Pay", "Satispay", "Bonifico"];
---

<Layout
  titolo="Prenota il tuo consulto"
  descrizione="Prenota il tuo consulto ARIA compilando il modulo: scegli il tipo di consulto, il giorno e la fascia oraria che preferisci."
>
  <IntestazionePagina
    occhiello="Prenota"
    titolo="Prenota il tuo consulto"
    sottotitolo="Compila il modulo con le tue preferenze: ti ricontatto io per confermare giorno e orario. È semplice e senza impegno."
  />

  <section class="sezione">
    <div class="contenitore prenota">
      <div class="prenota__modulo rivela">
        <form id="modulo-prenotazione" novalidate>
          <div class="campi">
            <div class="campo">
              <label for="nome">Nome e cognome *</label>
              <input type="text" id="nome" name="nome" required autocomplete="name" />
            </div>

            <div class="campo campo--meta">
              <div class="campo">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required autocomplete="email" />
              </div>
              <div class="campo">
                <label for="telefono">Telefono / WhatsApp</label>
                <input type="tel" id="telefono" name="telefono" autocomplete="tel" />
              </div>
            </div>

            <div class="campo campo--meta">
              <div class="campo">
                <label for="tipo">Tipo di consulto *</label>
                <select id="tipo" name="tipo_consulto" required>
                  <option value="" disabled selected>Scegli…</option>
                  {consulti.map((c) => <option value={c.nome}>{c.nome}</option>)}
                  <option value="Non so, aiutami a scegliere">Non so, aiutami a scegliere</option>
                </select>
              </div>
              <div class="campo">
                <label for="durata">Durata</label>
                <select id="durata" name="durata">
                  <option value="" disabled selected>Scegli…</option>
                  {tariffe.map((t) => <option value={t.servizio}>{t.servizio} — {t.prezzo}</option>)}
                </select>
              </div>
            </div>

            <div class="campo campo--meta">
              <div class="campo">
                <label for="giorno">Giorno preferito</label>
                <input type="date" id="giorno" name="giorno_preferito" />
              </div>
              <div class="campo">
                <label for="fascia">Fascia oraria preferita</label>
                <select id="fascia" name="fascia_oraria">
                  <option value="" disabled selected>Scegli…</option>
                  <option value="Mattina (9–13)">Mattina (9–13)</option>
                  <option value="Pomeriggio (13–18)">Pomeriggio (13–18)</option>
                  <option value="Sera (18–22)">Sera (18–22)</option>
                </select>
              </div>
            </div>

            <div class="campo">
              <label for="messaggio">Un messaggio per Aria (facoltativo)</label>
              <textarea id="messaggio" name="messaggio" rows="4" placeholder="Se vuoi, raccontami brevemente cosa ti porta qui…"></textarea>
            </div>

            <label class="consenso">
              <input type="checkbox" id="privacy" name="consenso_privacy" required />
              <span>
                Ho letto e accetto il trattamento dei miei dati per essere ricontattata
                riguardo alla prenotazione. *
              </span>
            </label>

            <!-- Anti-spam (non visibile) -->
            <input type="checkbox" name="botcheck" tabindex="-1" style="display:none" aria-hidden="true" />
          </div>

          <button type="submit" class="btn modulo__invia">Invia richiesta di prenotazione</button>

          <p class="modulo__esito" id="modulo-esito" role="status" aria-live="polite" hidden></p>
          <p class="modulo__nota">
            I campi con * sono obbligatori. Non è un pagamento: è una richiesta.
            Ti ricontatto io per confermare tutti i dettagli.
          </p>
        </form>
      </div>

      <aside class="prenota__lato">
        <div class="carta prenota__box rivela">
          <h3>I consulti disponibili</h3>
          <ul class="prenota__servizi">
            {consulti.map((c) => <li>{c.nome}</li>)}
          </ul>
          <a href="/offerte/" class="prenota__vedi">Vedi tariffe →</a>
        </div>

        <div class="carta prenota__box rivela">
          <h3>Preferisci un contatto diretto?</h3>
          <p>Puoi prenotare o chiedere informazioni anche subito:</p>
          <a href={whatsappLink} class="btn" target="_blank" rel="noopener" style="width:100%; justify-content:center;">
            Scrivimi su WhatsApp
          </a>
          <a href={`mailto:${contatti.email}`} class="prenota__email">{contatti.email}</a>
        </div>

        <div class="carta prenota__box rivela">
          <h3>Pagamenti accettati</h3>
          <ul class="loghi-pagamento">
            {metodiPagamento.map((m) => <li class="logo-pagamento logo-pagamento--chiaro">{m}</li>)}
          </ul>
          <p class="prenota__pagamento-nota">
            Il pagamento viene concordato alla conferma. Pagamento immediato online in arrivo.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ chiave: prenotazione.web3formsKey, emailDest: contatti.email }}>
  const form = document.getElementById("modulo-prenotazione");
  const esito = document.getElementById("modulo-esito");
  const bottone = form?.querySelector('button[type="submit"]');

  function mostraEsito(testo, tipo) {
    if (!esito) return;
    esito.textContent = testo;
    esito.hidden = false;
    esito.className = "modulo__esito modulo__esito--" + tipo;
  }

  function datiFormattati(fd) {
    const etichette = {
      nome: "Nome",
      email: "Email",
      telefono: "Telefono/WhatsApp",
      tipo_consulto: "Tipo di consulto",
      durata: "Durata",
      giorno_preferito: "Giorno preferito",
      fascia_oraria: "Fascia oraria",
      messaggio: "Messaggio",
    };
    return Object.entries(etichette)
      .map(([k, et]) => `${et}: ${fd.get(k) || "-"}`)
      .join("\n");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const fd = new FormData(form);
    if (bottone) { bottone.disabled = true; bottone.textContent = "Invio in corso…"; }

    // CASO 1 — Chiave Web3Forms configurata: invio automatico via email
    if (chiave && chiave.trim() !== "") {
      try {
        const payload = Object.fromEntries(fd.entries());
        payload.access_key = chiave;
        payload.subject = "Nuova richiesta di prenotazione — ARIA";
        payload.from_name = "Sito ARIA";

        const risposta = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        });
        const dati = await risposta.json();

        if (dati.success) {
          form.reset();
          mostraEsito("Grazie! La tua richiesta è stata inviata. Ti ricontatto al più presto. 🌙", "ok");
        } else {
          mostraEsito("Qualcosa è andato storto nell'invio. Riprova o scrivimi su WhatsApp.", "errore");
        }
      } catch (err) {
        mostraEsito("Connessione non riuscita. Riprova o scrivimi su WhatsApp.", "errore");
      } finally {
        if (bottone) { bottone.disabled = false; bottone.textContent = "Invia richiesta di prenotazione"; }
      }
      return;
    }

    // CASO 2 — Nessuna chiave: apre l'email precompilata (funziona senza configurazione)
    const corpo = encodeURIComponent(
      "Ciao Aria, vorrei prenotare un consulto.\n\n" + datiFormattati(fd)
    );
    const oggetto = encodeURIComponent("Richiesta di prenotazione — ARIA");
    window.location.href = `mailto:${emailDest}?subject=${oggetto}&body=${corpo}`;
    mostraEsito("Si aprirà la tua app email con la richiesta già pronta: premi Invia per completare.", "ok");
    if (bottone) { bottone.disabled = false; bottone.textContent = "Invia richiesta di prenotazione"; }
  });
</script>

<style>
  .prenota {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 940px) {
    .prenota { grid-template-columns: 1fr 340px; gap: 2.5rem; }
  }

  .prenota__modulo {
    background: #fff;
    border: 1px solid var(--bordo);
    border-radius: var(--raggio-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: var(--ombra-carta);
  }
  .campi { display: grid; gap: 1.4rem; }
  .campo { display: flex; flex-direction: column; gap: 0.45rem; }
  .campo--meta {
    display: grid;
    gap: 1.4rem;
  }
  @media (min-width: 560px) {
    .campo--meta { grid-template-columns: 1fr 1fr; }
  }
  .campo label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--blu-notte);
  }
  .campo input,
  .campo select,
  .campo textarea {
    font-family: inherit;
    font-size: 1rem;
    color: var(--testo);
    padding: 0.85rem 1rem;
    border: 1px solid var(--bordo);
    border-radius: 10px;
    background: var(--bianco);
    transition: border-color var(--transizione), box-shadow var(--transizione);
    width: 100%;
  }
  .campo textarea { resize: vertical; }
  .campo input:focus,
  .campo select:focus,
  .campo textarea:focus {
    outline: none;
    border-color: var(--oro);
    box-shadow: 0 0 0 3px rgba(199, 161, 74, 0.15);
  }

  .consenso {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.9rem;
    color: var(--testo-soft);
    cursor: pointer;
  }
  .consenso input {
    margin-top: 0.2rem;
    width: 18px;
    height: 18px;
    accent-color: var(--oro);
    flex: 0 0 auto;
  }

  .modulo__invia {
    margin-top: 1.8rem;
    width: 100%;
    justify-content: center;
  }
  .modulo__invia:disabled { opacity: 0.7; cursor: default; transform: none; }

  .modulo__esito {
    margin: 1.2rem 0 0;
    padding: 0.9rem 1.1rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .modulo__esito--ok {
    background: rgba(199, 161, 74, 0.12);
    border: 1px solid var(--bordo-oro);
    color: var(--blu-notte);
  }
  .modulo__esito--errore {
    background: #fdeceb;
    border: 1px solid #f3c2bd;
    color: #a3352b;
  }
  .modulo__nota {
    margin: 1rem 0 0;
    font-size: 0.82rem;
    color: var(--testo-soft);
  }

  /* Colonna laterale */
  .prenota__lato { display: grid; gap: 1.5rem; }
  .prenota__box h3 { font-size: 1.25rem; margin-bottom: 1rem; }
  .prenota__servizi {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .prenota__servizi li {
    padding-left: 1.5rem;
    position: relative;
    color: var(--testo-soft);
  }
  .prenota__servizi li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--oro);
  }
  .prenota__vedi, .prenota__email {
    font-weight: 600;
    color: var(--blu-notte);
  }
  .prenota__vedi:hover, .prenota__email:hover { color: var(--oro); }
  .prenota__email {
    display: block;
    margin-top: 1rem;
    text-align: center;
    font-size: 0.95rem;
  }
  .loghi-pagamento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .logo-pagamento--chiaro {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--bordo);
    border-radius: 8px;
    color: var(--testo);
    background: var(--bianco);
  }
  .prenota__pagamento-nota {
    margin: 1rem 0 0;
    font-size: 0.82rem;
    color: var(--testo-soft);
  }
</style>
